# 복사해서 .env 로 만든 뒤 값을 채운다.  cp .env.example .env
# .env 는 절대 git 에 올리지 않는다. docker-compose 와 Spring Boot 가 같은 파일을 읽는다.

# --- MySQL (설치형 또는 docker-compose) ---
# 설치형 MySQL 을 쓰면 3306. 도커로 띄우는데 이 PC 에 이미 MySQL 이 3306 을 쓰고 있다면 3307 등 다른 값으로 바꾼다.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=disciple
DB_USER=disciple
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# --- Server ---
SERVER_PORT=8080
# FE 주소. 쉼표로 여러 개 지정 (예: 로컬 + 배포 주소)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI (기능 구현 시 사용) ---
GEMINI_API_KEY=

# --- 인증 ---
# 액세스 토큰 서명 키. 32바이트 이상의 임의 문자열 (예: openssl rand -base64 48). 바꾸면 모든 로그인이 풀린다.
JWT_SECRET=
# Google OAuth 클라이언트 ID. ID 토큰의 aud 검사용. 비어 있으면 Google 로그인이 동작하지 않는다 (local 은 dev-login 사용)
GOOGLE_CLIENT_ID=

# --- 터널 뒤에서 실행할 때만 ---
# IP 별 사용량 제한이 실제 접속자 IP 로 세도록 FRAMEWORK 로 바꾼다. 포트가 터널로만 열려 있을 때만 켠다.
FORWARD_HEADERS_STRATEGY=none
